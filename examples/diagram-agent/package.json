{
  "name": "@cintelisai/diagram-agent",
  "version": "0.1.0",
  "description": "A Standard Agent that designs draw.io diagrams. A TypeScript agent drives a diagram builder, checker, and SVG renderer written in Rust and compiled to WebAssembly.",
  "license": "MIT",
  "author": "Cintelis",
  "homepage": "https://github.com/cintelis/standardagent-catalogue/tree/main/examples/diagram-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cintelis/standardagent-catalogue.git",
    "directory": "examples/diagram-agent"
  },
  "bugs": {
    "url": "https://github.com/cintelis/standardagent-catalogue/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drawgen_core.wasm": "./dist/drawgen_core.wasm"
  },
  "imports": {
    "#wasm-module": {
      "workerd": "./dist/wasm-module.workerd.js",
      "default": "./dist/wasm-module.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "standardagent",
    "agent",
    "diagram",
    "drawio",
    "webassembly"
  ],
  "standardagent": {
    "entryAgents": [
      "diagram_designer"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/build.mjs && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && cargo test --manifest-path rust/Cargo.toml && node --test test/*.test.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@standardagents/anthropic": "0.45.10",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@standardagents/spec": "^0.45.10"
  },
  "devDependencies": {
    "@standardagents/spec": "0.45.10",
    "typescript": "^7.0.2"
  }
}
