---
import Identicon from '../../components/Identicon.astro';
import Base from '../../layouts/Base.astro';
import { formatCount, formatDate, getCatalogue, type AgentPackage } from '../../lib/npm';

export async function getStaticPaths() {
  const { agents } = await getCatalogue();
  return agents.map((pkg) => ({ params: { name: pkg.name }, props: { pkg } }));
}

interface Props {
  pkg: AgentPackage;
}

const { pkg } = Astro.props;
const external = 'noopener noreferrer nofollow';
---

<Base title={pkg.name} description={pkg.description || `${pkg.name}, a Standard Agent package.`}>
  <h1 class="crumbs">
    <Identicon name={pkg.name} class="avatar-small" />
    <a href="/">Agents</a>
    <span class="sep">/</span>
    <strong>{pkg.name}</strong>
    <span class="label">v{pkg.version}</span>
  </h1>

  <div class="columns">
    <div>
      <section class="box">
        <h2 class="box-header">Install</h2>
        <div class="box-body">
          <pre><code>npm install {pkg.name}</code></pre>
        </div>
      </section>

      <p class="note">
        This page is built from the package's own metadata. Nobody has reviewed the package. It
        contains executable code, so read it before you install it.
      </p>

      <section class="box">
        <h2 class="box-header">
          Entry agents
          <span class="counter">{pkg.entryAgents.length}</span>
        </h2>
        <div class="box-body">
          <ul class="tags">
            {pkg.entryAgents.map((agent) => <li>{agent}</li>)}
          </ul>
        </div>
      </section>

      {
        pkg.parentHooks.length > 0 && (
          <section class="box">
            <h2 class="box-header">Hooks added to a parent</h2>
            <div class="box-body">
              <p class="lede">
                When another agent composes one of these agents as a child, the package runs these
                hooks on the parent's thread.
              </p>
              <ul class="plain-list">
                {pkg.parentHooks.map((entry) =>
                  entry.hooks.map((hook) => (
                    <li>
                      <code>{hook.hook}</code> for <code>{entry.agent}</code>
                      {hook.stage && <> ({hook.stage})</>}
                      {hook.reason && <>: {hook.reason}</>}
                    </li>
                  )),
                )}
              </ul>
            </div>
          </section>
        )
      }

      {
        pkg.effects.length > 0 && (
          <section class="box">
            <h2 class="box-header">
              Effects
              <span class="counter">{pkg.effects.length}</span>
            </h2>
            <div class="box-body">
              <ul class="tags">
                {pkg.effects.map((effect) => (
                  <li>{effect}</li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      {
        pkg.threadEndpoints.length > 0 && (
          <section class="box">
            <h2 class="box-header">
              Thread endpoints
              <span class="counter">{pkg.threadEndpoints.length}</span>
            </h2>
            <div class="box-body">
              <ul class="tags">
                {pkg.threadEndpoints.map((endpoint) => (
                  <li>{endpoint}</li>
                ))}
              </ul>
            </div>
          </section>
        )
      }
    </div>

    <aside class="side">
      <h2>About</h2>
      {pkg.description && <p class="lede">{pkg.description}</p>}
      <dl class="facts">
        <dt>Version</dt>
        <dd>{pkg.version}</dd>
        {
          pkg.date && (
            <>
              <dt>Published</dt>
              <dd>{formatDate(pkg.date)}</dd>
            </>
          )
        }
        {
          pkg.specRange && (
            <>
              <dt>Specification helpers</dt>
              <dd>
                <code>@standardagents/spec {pkg.specRange}</code>
              </dd>
            </>
          )
        }
        {
          pkg.license && (
            <>
              <dt>Licence</dt>
              <dd>{pkg.license}</dd>
            </>
          )
        }
        {
          pkg.publisher && (
            <>
              <dt>Publisher</dt>
              <dd>{pkg.publisher}</dd>
            </>
          )
        }
        {
          pkg.monthlyDownloads !== null && (
            <>
              <dt>Downloads</dt>
              <dd>{formatCount(pkg.monthlyDownloads)} in the last month</dd>
            </>
          )
        }
        <dt>Links</dt>
        <dd>
          <a href={pkg.links.npm} rel={external}>npm</a>
          {
            pkg.links.repository && (
              <>
                {' · '}
                <a href={pkg.links.repository} rel={external}>
                  Repository
                </a>
              </>
            )
          }
          {
            pkg.links.homepage && (
              <>
                {' · '}
                <a href={pkg.links.homepage} rel={external}>
                  Home page
                </a>
              </>
            )
          }
        </dd>
      </dl>
    </aside>
  </div>
</Base>
