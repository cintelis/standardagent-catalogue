---
import '../styles/global.css';
import HeaderArt from '../components/HeaderArt.astro';
import Icon from '../components/Icon.astro';
import { formatDate, getCatalogue } from '../lib/npm';

interface Props {
  title: string;
  description: string;
}

const { title } = Astro.props;
// A package page passes publisher text here. Astro escapes quotes, so the
// attribute is safe, and dropping angle brackets keeps markup out of it too.
const description = Astro.props.description.replace(/[<>]/g, '');
const { agents, ecosystem, fetchedAt } = await getCatalogue();

// A tab with a count shows it in a small pill, as a code-hosting site does.
const nav: {
  href: string;
  label: string;
  icon: 'agents' | 'ecosystem' | 'runtimes' | 'publish';
  count?: number;
}[] = [
  { href: '/', label: 'Agents', icon: 'agents', count: agents.length },
  { href: '/ecosystem/', label: 'Ecosystem', icon: 'ecosystem', count: ecosystem.length },
  { href: '/runtimes/', label: 'Runtimes', icon: 'runtimes' },
  { href: '/publish/', label: 'Publish', icon: 'publish' },
];
const source = 'https://github.com/cintelis/standardagent-catalogue';
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/package/') : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Standard Agent Catalogue</title>
  </head>
  <body>
    <header class="site-header">
      <HeaderArt />
      <div class="wrap">
        <div class="brand-row">
          <a class="brand" href="/">
            <!-- The logo in public/favicon.svg, without its dark tile: three
                 packages and one agent. The squares take the colour of the
                 text, so the logo reads in a light and a dark setting. -->
            <svg class="brand-mark" viewBox="5.5 5.5 21 21" aria-hidden="true">
              <rect x="5.5" y="5.5" width="9" height="9" rx="2.2" />
              <rect x="17.5" y="5.5" width="9" height="9" rx="2.2" />
              <rect x="5.5" y="17.5" width="9" height="9" rx="2.2" />
              <circle class="brand-agent" cx="22" cy="22" r="4.5" />
            </svg>
            Standard Agent Catalogue
          </a>
          <span class="label">Open index</span>
          <span class="header-links">
            <a class="btn" href="/catalogue.json"><Icon name="data" /> JSON</a>
            <a class="btn" href={source} rel="noopener noreferrer"><Icon name="code" /> Source</a>
          </span>
        </div>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span>
                  <Icon name={item.icon} />
                  {item.label}
                </span>
                {item.count !== undefined && <span class="counter">{item.count}</span>}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Package data comes from the public npm registry and was last read on {
            formatDate(fetchedAt)
          }. Names, descriptions, and links are written by each package's publisher.
        </p>
        <p>
          A listing is automatic. It is not a review, an endorsement, or a statement that a
          package conforms to the specification. Agent packages contain executable code, so read
          one before you install it.
        </p>
        <ul class="footer-links">
          <li><a href="/catalogue.json">Catalogue as JSON</a></li>
          <li><a href="/publish/">Publish an agent</a></li>
          <li>
            <a href="https://standardagentspec.org" rel="noopener noreferrer">Specification</a>
          </li>
          <li><a href={source} rel="noopener noreferrer">Source on GitHub</a></li>
          <li>
            <a href={`${source}/blob/main/CONTRIBUTING.md`} rel="noopener noreferrer">
              Contribute
            </a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>
