// Deploys the built site to Cloudflare as static files. No code runs on
// Cloudflare: there is no "main" script, only the files in dist/.
// .github/workflows/deploy.yml runs `wrangler deploy` with this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "standardagent-catalogue",
  "compatibility_date": "2026-11-01",
  // The site's address. Cloudflare creates the DNS record and the certificate
  // when this is deployed. The zone cintelis.ai is in the same account.
  "routes": [{ "pattern": "agents.cintelis.ai", "custom_domain": true }],
  // Wrangler turns the workers.dev address off once a route is set. Keep it,
  // as a second way in if the domain has a problem.
  "workers_dev": true,
  "assets": {
    // Cloudflare reads dist/_headers, which comes from public/_headers, and
    // sends the security headers in it with every response.
    "directory": "./dist",
    // An unknown address gets dist/404.html, from src/pages/404.astro.
    "not_found_handling": "404-page"
  }
}
